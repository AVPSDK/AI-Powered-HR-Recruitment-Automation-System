    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst consentStatement =\n  \"I consent to the collection and processing of my application information and resume for recruitment purposes. I understand that my information will be accessible to authorized recruitment personnel and handled according to the organization's privacy policy.\";\n\nreturn items.map(item => {\n  const date = new Date()\n    .toISOString()\n    .slice(0, 10)\n    .replace(/-/g, '');\n\n  const uniqueSuffix = Math.random()\n    .toString(16)\n    .slice(2, 8)\n    .toUpperCase();\n\n  const applicationId = `APP-${date}-${uniqueSuffix}`;\n\n  // Use the already normalized Job ID\n  const normalizedJobId = item.json.normalizedJobId;\n\n  // Convert the consent checkbox value into Yes/No\n  const rawConsent = item.json.consent;\n\n  const consentGiven = Array.isArray(rawConsent)\n    ? rawConsent.includes(consentStatement)\n    : rawConsent === true ||\n      rawConsent === 'true' ||\n      rawConsent === 'Yes';\n\n  return {\n    json: {\n      ...item.json,\n      applicationId,\n      jobId: normalizedJobId,\n      consent: consentGiven ? 'Yes' : 'No'\n    },\n    binary: item.binary\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
