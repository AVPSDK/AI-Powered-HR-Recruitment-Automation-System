    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const rawEmail = item.json.email;\n  const rawJobId = item.json.jobID;\n\n  // Normalize email\n  const normalizedEmail =\n    String(rawEmail || '').trim().toLowerCase();\n\n  // Extract the actual Job ID\n  const normalizedJobId =\n    typeof rawJobId === 'string'\n      ? rawJobId.split(' - ')[0].trim()\n      : '';\n\n  return {\n    json: {\n      ...item.json,\n      normalizedEmail,\n      normalizedJobId\n    },\n    binary: item.binary\n  };\n});"
      },
