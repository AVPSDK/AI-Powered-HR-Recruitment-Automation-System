{
  "name": "WF-03 - Job Description Analysis",
  "nodes": [
    {
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "HR Job Description Submission",
        "formDescription": "Submit a new job description or update an existing job. The system will analyze the job requirements and store the structured information.",
