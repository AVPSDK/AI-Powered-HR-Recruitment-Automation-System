    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\n\nconst interviewId = String(\n  data.interviewId ?? data[\"Interview ID\"] ?? \"UNKNOWN\"\n).trim();\n\nconst status = String(\n  data.interviewStatus ?? data[\"Interview Status\"] ?? \"\"\n).trim();\n\nconst interviewDate = String(\n  data.interviewDate ?? data[\"Interview Date\"] ?? \"\"\n).trim();\n\nconst interviewTime = String(\n  data.interviewTime ?? data[\"Interview Time\"] ?? \"\"\n).trim();\n\nconst clean = (value) =>\n  String(value).replace(/[^a-zA-Z0-9]/g, \"\");\n\nlet notificationId = \"\";\nlet notificationType = \"\";\n\nif (status === \"Scheduled\") {\n  notificationId = `INT-${clean(interviewId)}-CONF`;\n  notificationType = \"Interview Confirmation\";\n} else if (status === \"Rescheduled\") {\n  const fingerprint = `${clean(interviewDate)}-${clean(interviewTime)}`;\n  notificationId = `INT-${clean(interviewId)}-RESCHED-${fingerprint}`;\n  notificationType = \"Interview Rescheduled\";\n}\n\nreturn {\n  json: {\n    ...data,\n    notificationId,\n    notificationType\n  }\n};"
      },
