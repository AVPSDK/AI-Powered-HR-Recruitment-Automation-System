    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\nconst errors = [];\n\nconst interviewId = String(data[\"Interview ID\"] ?? \"\").trim();\nconst applicationId = String(data[\"Application ID\"] ?? \"\").trim();\nconst candidateName = String(data[\"Candidate Name\"] ?? \"\").trim();\nconst candidateEmail = String(data[\"Candidate Email\"] ?? \"\").trim();\nconst jobTitle = String(data[\"Job Title\"] ?? \"\").trim();\nconst interviewDate = data[\"Interview Date\"] ?? \"\";\nconst interviewTime = data[\"Interview Time\"] ?? \"\";\nconst interviewMode = String(data[\"Interview Mode\"] ?? \"\").trim();\nconst meetingLink = String(data[\"Meeting Link\"] ?? \"\").trim();\nconst interviewStatus = String(data[\"Interview Status\"] ?? \"\").trim();\nconst hrNotes = String(data[\"HR Notes\"] ?? \"\").trim();\n\n// Required fields\nif (!interviewId) errors.push(\"Missing Interview ID.\");\nif (!applicationId) errors.push(\"Missing Application ID.\");\nif (!candidateName) errors.push(\"Missing Candidate Name.\");\nif (!candidateEmail) {\n  errors.push(\"Missing Candidate Email.\");\n} else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(candidateEmail)) {\n  errors.push(\"Invalid Candidate Email format.\");\n}\nif (!jobTitle) errors.push(\"Missing Job Title.\");\nif (!interviewDate) errors.push(\"Missing Interview Date.\");\nif (!interviewTime) errors.push(\"Missing Interview Time.\");\n\n// Interview mode validation\nif (!interviewMode) {\n  errors.push(\"Missing Interview Mode.\");\n} else if (![\"Online\", \"In-person\"].includes(interviewMode)) {\n  errors.push(\"Interview Mode must be Online or In-person.\");\n}\n\n// Online interview requires a meeting link\nif (interviewMode === \"Online\" && !meetingLink) {\n  errors.push(\"Meeting Link is required for Online interviews.\");\n}\n\n// Notification eligibility\nconst eligibleStatus = [\"Scheduled\", \"Rescheduled\"].includes(interviewStatus);\nconst validationPassed = errors.length === 0;\nconst notificationReady = validationPassed && eligibleStatus;\n\nlet notificationType = \"\";\n\nif (interviewStatus === \"Scheduled\") {\n  notificationType = \"Interview Confirmation\";\n} else if (interviewStatus === \"Rescheduled\") {\n  notificationType = \"Interview Rescheduled\";\n}\n\nreturn {\n  json: {\n    ...data,\n    interviewId,\n    applicationId,\n    candidateName,\n    candidateEmail,\n    jobTitle,\n    interviewDate,\n    interviewTime,\n    interviewMode,\n    meetingLink,\n    interviewStatus,\n    hrNotes,\n    validationPassed,\n    notificationReady,\n    notificationType,\n    interviewValidationErrors: errors\n  }\n};"
      },
