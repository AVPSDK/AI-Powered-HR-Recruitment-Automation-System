      ],
      "id": "88e5ce60-554f-4e1f-94bf-bb035d275e24",
      "name": "Check Categorization Eligibility"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\nconst score = Number(data.aiMatchScore);\n\nlet candidateCategory;\n\nif (score >= 80 && score <= 100) {\n  candidateCategory = \"Strong Match\";\n} else if (score >= 60 && score < 80) {\n  candidateCategory = \"Potential Match\";\n} else if (score >= 0 && score < 60) {\n  candidateCategory = \"HR Review\";\n} else {\n  candidateCategory = \"Manual Review\";\n}\n\nreturn {\n  json: {\n    ...data,\n    candidateCategory\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        -96
      ],
      "id": "86079319-a3b4-47c8-96fb-caf395d980fc",
      "name": "Calculate Candidate Category"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\n\nconst errors = Array.isArray(data.categorizationErrors)\n  ? data.categorizationErrors\n  : [\"Application requires manual verification.\"];\n\nconst explanation = [\n  \"MANUAL REVIEW REQUIRED\",\n  \"Candidate categorization was not completed.\",\n  ...errors.map(error => \"- \" + error),\n  \"HR action: Verify the application, AI match score, and matching explanation before proceeding.\"\n].join(\"\\n\");\n\nreturn {\n  json: {\n    ...data,\n    candidateCategory: \"Manual Review\",\n    categorizationReviewExplanation: explanation\n  }\n};\n"
      },
