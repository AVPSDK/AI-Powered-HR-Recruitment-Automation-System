    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\n\nconst errors = [];\n\nconst applicationId = String(data[\"Application ID\"] ?? \"\").trim();\nconst rawScore = data[\"AI Match Score\"];\nconst explanation = String(data[\"Matching Explanation\"] ?? \"\").trim();\n\nconst scoreText = String(rawScore ?? \"\").trim();\nconst score = scoreText === \"\" ? NaN : Number(scoreText);\n\nif (!applicationId) {\n  errors.push(\"Missing Application ID.\");\n}\n\nif (scoreText === \"\") {\n  errors.push(\"AI Match Score is missing.\");\n} else if (!Number.isFinite(score)) {\n  errors.push(\"AI Match Score is not a valid number.\");\n} else if (score < 0 || score > 100) {\n  errors.push(\"AI Match Score must be between 0 and 100.\");\n}\n\nif (!explanation) {\n  errors.push(\"Matching Explanation is missing.\");\n}\n\nif (explanation.toUpperCase().includes(\"MANUAL REVIEW REQUIRED\")) {\n  errors.push(\"WF-04 marked this application for manual review.\");\n}\n\nconst categorizationReady = errors.length === 0;\n\nreturn {\n  json: {\n    ...data,\n    candidateApplicationId: applicationId,\n    aiMatchScore: categorizationReady ? score : null,\n    matchingExplanation: explanation,\n    categorizationReady,\n    categorizationErrors: errors\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "c9fd5e6f-60b7-463e-8c18-8d6f11649fc9",
      "name": "Validate Categorization Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "f86fef29-7b03-4936-ac3f-58937bea6add",
              "leftValue": "={{ $json.categorizationReady }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
