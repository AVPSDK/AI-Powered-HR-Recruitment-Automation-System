    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst resumeLink = $json[\"Resume Link\"];\n\nif (!resumeLink || typeof resumeLink !== \"string\") {\n  throw new Error(\"Resume Link is missing or invalid.\");\n}\n\nconst patterns = [\n  /\\/file\\/d\\/([a-zA-Z0-9_-]+)/,\n  /\\/document\\/d\\/([a-zA-Z0-9_-]+)/,\n  /[?&]id=([a-zA-Z0-9_-]+)/\n];\n\nlet fileId = null;\n\nfor (const pattern of patterns) {\n  const match = resumeLink.match(pattern);\n\n  if (match) {\n    fileId = match[1];\n    break;\n  }\n}\n\nif (!fileId) {\n  throw new Error(\"Could not extract Google Drive File ID.\");\n}\n\nreturn {\n  ...$json,\n  driveFileId: fileId\n};\n"
      },
