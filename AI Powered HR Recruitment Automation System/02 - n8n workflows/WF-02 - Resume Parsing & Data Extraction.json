      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst applicationId = $json[\"Application ID\"] || \"UNKNOWN\";\n\nconst missingFields = [];\n\nif ($json[\"Consent Status\"] !== \"Yes\") {\n  missingFields.push(\"Valid consent is missing\");\n}\n\nif (!$json[\"Resume Link\"]) {\n  missingFields.push(\"Resume Link is missing\");\n}\n\nif (!$json[\"Application ID\"]) {\n  missingFields.push(\"Application ID is missing\");\n}\n\nreturn {\n  json: {\n    applicationId,\n    processingStatus: \"Not Processed\",\n    validationIssues: missingFields,\n    loggedAt: new Date().toISOString()\n  }\n};\n"
