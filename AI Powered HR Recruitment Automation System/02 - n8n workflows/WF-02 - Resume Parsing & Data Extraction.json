      "id": "aca8547b-bb2c-4eee-a8b4-29c8a5f41be7",
      "name": "Merge — Original Application & Parsed AI Data"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\n\nif (!data[\"Application ID\"]) {\n  throw new Error(\"Application ID is missing.\");\n}\n\nconst arrayToText = (value) => {\n  if (!Array.isArray(value)) {\n    throw new Error(\"Expected an array while formatting resume data.\");\n  }\n\n  return value.length > 0\n    ? [...new Set(\n        value\n          .map(item => String(item).trim())\n          .filter(Boolean)\n      )].join(\", \")\n    : \"\";\n};\n\nconst parsedSkills = [\n  ...new Set([\n    ...data.technical_skills,\n    ...data.projects,\n    ...data.certifications,\n    ...data.other_relevant_achievements\n  ].map(item => String(item).trim()).filter(Boolean))\n].join(\"\\n\");\n\nconst education = arrayToText(data.education);\n\nconst experience = [\n  data.experience_summary || \"\",\n  ...data.work_experience\n].filter(Boolean).join(\"\\n\");\n\nreturn {\n  json: {\n    ...data,\n    formattedParsedSkills: parsedSkills,\n    formattedEducation: education,\n    formattedExperience: experience\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
